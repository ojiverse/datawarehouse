# 1Password secret references for the #36 R2 spike (ojilab account, vault datawarehouse-dev).
# No secret values live here. Run: op run --account ojilab --env-file spike/r2-dev.op.env -- scripts/spike.sh loop
DWH_ARCHIVE_S3_ENDPOINT=op://datawarehouse-dev/cloudflare-r2-dwh-spike/cloudflare/archive s3 endpoint
DWH_ARCHIVE_BUCKET=op://datawarehouse-dev/cloudflare-r2-dwh-spike/cloudflare/archive bucket
DWH_ARCHIVE_REGION=auto
DWH_ARCHIVE_ACCESS_KEY_ID=op://datawarehouse-dev/cloudflare-r2-dwh-spike/r2 s3/access key id
DWH_ARCHIVE_SECRET_ACCESS_KEY=op://datawarehouse-dev/cloudflare-r2-dwh-spike/r2 s3/secret access key
DWH_CATALOG_URI=op://datawarehouse-dev/cloudflare-r2-dwh-spike/cloudflare/catalog uri
DWH_CATALOG_WAREHOUSE=op://datawarehouse-dev/cloudflare-r2-dwh-spike/cloudflare/catalog warehouse
DWH_CATALOG_TOKEN=op://datawarehouse-dev/cloudflare-r2-dwh-spike/credential
DWH_R2SQL_ACCOUNT_ID=op://datawarehouse-dev/cloudflare-r2-dwh-spike/cloudflare/account id
DWH_R2SQL_BUCKET=op://datawarehouse-dev/cloudflare-r2-dwh-spike/cloudflare/canonical bucket
DWH_R2SQL_TOKEN=op://datawarehouse-dev/cloudflare-r2-dwh-spike/credential
